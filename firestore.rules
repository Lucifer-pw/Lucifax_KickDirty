rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Get the user data of the currently authenticated user
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Get the role of the currently authenticated user
    function getUserRole() {
      return getUserData().role;
    }

    function isOwnerOrStaff() {
      return request.auth != null && getUserRole() in ['owner', 'staff', 'developer'];
    }

    function isOwnerOrDeveloper() {
      let role = getUserRole();
      return role == 'developer' || (role == 'owner' && get(/databases/$(database)/documents/app_config/version_info).data.enableOwnerLogs == true);
    }

    function isDeveloper() {
      return request.auth != null && getUserRole() == 'developer';
    }

    function isOwner() {
      return request.auth != null && getUserRole() == 'owner';
    }

    // Check if the request is NOT trying to change the 'role' field
    function notChangingRole() {
      return !('role' in request.resource.data) || request.resource.data.role == resource.data.role;
    }

    // ============================================
    // 1. USERS COLLECTION
    // FIX: Prevent role self-escalation
    // FIX: Users can only read their own profile (unless admin)
    // ============================================
    match /users/{userId} {
      // Users can read their own doc. Admins can read all.
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isOwnerOrStaff());

      // User can create their own doc on registration (role must be 'customer')
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'customer';

      // User can update their own doc BUT cannot change role.
      // Admins can update any user doc (including role changes).
      allow update: if request.auth != null
                    && (
                      (request.auth.uid == userId && notChangingRole())
                      || isOwnerOrStaff()
                    );

      // Only admins can delete user docs
      allow delete: if request.auth != null && isOwnerOrStaff();
    }

    // ============================================
    // 2. PHONE LOOKUPS COLLECTION
    // FIX: Allow get (single doc) without auth for login flow,
    //      but block list (enumerate all docs).
    //      Require auth for create/update.
    // ============================================
    match /phone_lookups/{phone} {
      // Allow reading a SINGLE doc by phone number (for login flow)
      // but do NOT allow listing all docs (prevents data enumeration)
      allow get: if true;
      allow list: if request.auth != null && isOwnerOrStaff();

      // Only authenticated users can create/update their own lookup
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.uid || isOwnerOrStaff());
      allow delete: if request.auth != null && isOwnerOrStaff();
    }

    // ============================================
    // 3. SERVICES COLLECTION (pricing list - public)
    // ============================================
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null && isOwnerOrStaff();
    }

    // ============================================
    // 4. ORDERS COLLECTION
    // FIX: Only order owner or admin can read/update orders
    // FIX: Validate critical fields on update
    // ============================================
    match /orders/{orderId} {
      // Public read for reviews (showOnWeb == true), otherwise auth + ownership/admin
      allow get: if (resource != null && resource.data.showOnWeb == true)
                 || (request.auth != null
                     && (isOwnerOrStaff()
                         || resource.data.customerId == request.auth.uid
                         || resource.data.customerPhone == getUserData().phoneNumber));

      allow list: if (request.auth != null
                      && (
                        isOwnerOrStaff()
                        || request.auth.uid == resource.data.customerId
                        || getUserData().phoneNumber == resource.data.customerPhone
                      ))
                  || (resource != null && resource.data.showOnWeb == true);

      // Only authenticated users can create orders; customerId must match auth uid
      allow create: if request.auth != null
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.totalAmount >= 0;

      // Only admin/staff can update order status and payment fields.
      // Customer can only update review-related fields on their own order.
      allow update: if request.auth != null
                    && (
                      isOwnerOrStaff()
                      || (
                        resource.data.customerId == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['status', 'paymentStatus', 'totalAmount', 'deliveryFee', 'pointsEarned', 'pointsRedeemed'])
                      )
                    );

      allow delete: if request.auth != null && isOwnerOrStaff();
    }

    // ============================================
    // 5. EXPENSES COLLECTION
    // ============================================
    match /expenses/{expenseId} {
      allow read: if request.auth != null && isOwnerOrStaff();
      allow write: if request.auth != null && isOwnerOrStaff();
    }

    // ============================================
    // 6. APP CONFIG
    // FIX: Sensitive config (whatsapp_config) only readable by admin
    //      Public config (version_info, business_config, etc.) stays public
    // ============================================
    match /app_config/{docId} {
      // Sensitive docs: only admin can read
      allow read: if docId != 'whatsapp_config' || isOwnerOrStaff();
      allow write: if request.auth != null && isOwnerOrStaff();
    }

    // ============================================
    // 7. LOGISTICS METHODS COLLECTION
    // ============================================
    match /logistics_methods/{methodId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isOwnerOrStaff();
    }

    // ============================================
    // 8. CATEGORIES COLLECTION (public pricing)
    // ============================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && isOwnerOrStaff();
    }

    // ============================================
    // 9. VOUCHERS COLLECTION
    // ============================================
    match /vouchers/{voucherId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isOwnerOrStaff();
    }

    // ============================================
    // 10. COUNTERS COLLECTION
    // FIX: Only admin can write (prevent invoice manipulation)
    // ============================================
    match /counters/{counterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isOwnerOrStaff();
    }

    // ============================================
    // 11. CUSTOMERS COLLECTION
    // FIX: Customer can read own doc only. Admin can read all.
    // ============================================
    match /customers/{customerId} {
      allow read: if request.auth != null
                  && (request.auth.uid == customerId || isOwnerOrStaff());
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && (request.auth.uid == customerId || isOwnerOrStaff());
      allow delete: if request.auth != null && isOwnerOrStaff();
    }

    // ============================================
    // 12. CHAT ROOMS COLLECTION
    // FIX: Only participants can read/write their own chat room
    // ============================================
    match /chat_rooms/{chatRoomId} {
      // Chat room doc ID = customerId. Customer can access own room. Admin can access all.
      allow read: if request.auth != null
                  && (request.auth.uid == chatRoomId || isOwnerOrStaff());
      allow create: if request.auth != null
                    && (request.auth.uid == chatRoomId || isOwnerOrStaff());
      allow update: if request.auth != null
                    && (request.auth.uid == chatRoomId || isOwnerOrStaff());
      allow delete: if request.auth != null && isOwnerOrStaff();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && (request.auth.uid == chatRoomId || isOwnerOrStaff());
        allow create: if request.auth != null
                      && (request.auth.uid == chatRoomId || isOwnerOrStaff());
        allow update, delete: if request.auth != null && isOwnerOrStaff();
      }
    }

    // ============================================
    // 13. DEVELOPER BILLING CONFIG COLLECTION
    // ============================================
    match /developer_billing/{docId} {
      allow read: if request.auth != null && (isOwnerOrStaff() || isDeveloper());
      allow write: if request.auth != null && isDeveloper();
    }

    // ============================================
    // 14. DEVELOPER BILLING INVOICES COLLECTION
    // FIX: Only developer/owner can write
    // ============================================
    match /developer_billing_invoices/{docId} {
      allow read: if request.auth != null && (isOwnerOrStaff() || isDeveloper());
      allow write: if request.auth != null && (isDeveloper() || isOwner());
    }

    // ============================================
    // 15. LOGIN LOGS COLLECTION (single doc per user)
    // ============================================
    match /login_logs/{logId} {
      // Users can only create/update their own log doc
      allow create: if request.auth != null && request.auth.uid == logId;
      allow update: if request.auth != null && request.auth.uid == logId;
      allow read: if request.auth != null && isOwnerOrStaff();
      allow delete: if request.auth != null && isDeveloper();
    }

    // ============================================
    // 16. ACTIVITY LOGS COLLECTION
    // ============================================
    match /activity_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && isOwnerOrDeveloper();
    }

    // ============================================
    // 17. CHATS COLLECTION (dev support chat)
    // ============================================
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && (isOwnerOrStaff() || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && (isOwnerOrStaff() || request.auth.uid in resource.data.participants);
      allow delete: if request.auth != null && isOwnerOrStaff();

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && isOwnerOrStaff();
      }
    }
  }
}
